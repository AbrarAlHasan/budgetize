{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "ios": {
        "distribution": "internal"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "******",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "*****",
        "EXPO_PUBLIC_ANDROID_GOOGLE_CLIENT_ID": "*****",
        "EXPO_PUBLIC_IOS_GOOGLE_CLIENT_ID": "******",
        "EXPO_PUBLIC_BACKUP_BUCKET": "transactions",
        "EXPO_PUBLIC_POST_HOG_API_KEY": "*****",
        "EXPO_PUBLIC_POST_HOG_HOST": "*****"
      }
    },
    "production-apk": {
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      },
      "channel": "production",
      "env":  {
        "EXPO_PUBLIC_SUPABASE_URL": "******",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "*****",
        "EXPO_PUBLIC_ANDROID_GOOGLE_CLIENT_ID": "*****",
        "EXPO_PUBLIC_IOS_GOOGLE_CLIENT_ID": "******",
        "EXPO_PUBLIC_BACKUP_BUCKET": "transactions",
        "EXPO_PUBLIC_POST_HOG_API_KEY": "*****",
        "EXPO_PUBLIC_POST_HOG_HOST": "*****"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
