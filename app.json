{
  "expo": {
    "name": "moneyManager",
    "slug": "moneyManager",
    "version": "0.39",
    "orientation": "portrait",
    "icon": "./assets/images/ic_launcher_latest.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_latest.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abrarhasanprogrammer.moneyManager"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8504b6b9-245d-405e-a4cb-d0d2e2e5031f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8504b6b9-245d-405e-a4cb-d0d2e2e5031f"
    }
  }
}
